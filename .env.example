API_PORT=4000
MEDIA_PUBLIC_API_ORIGIN=http://127.0.0.1:4000
UFIT_DB_SCHEMA=ufit
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=your-server-secret-key
SUPABASE_DIRECT_CONNECTION_DB_URL=postgres://postgres:password@db.your-project.supabase.co:5432/postgres
SUPABASE_DB_SSL=true
SUPABASE_DB_TLS_REJECT_UNAUTHORIZED=false

# Email delivery is opt-in. New business messages are still queued while disabled.
NOTIFICATION_EMAIL_ENABLED=false
RESEND_BASE_URL=https://api.resend.com
RESEND_SEND_PATH=/emails
RESEND_FROM_NAME=Ufit
RESEND_FROM_ADDRESS=
RESEND_API_KEY=
RESEND_TIMEOUT_MS=10000
